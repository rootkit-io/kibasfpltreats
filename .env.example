# Copy to .env (next to docker-compose.yml) and fill in before deploying.
# Production: every value below is read by `docker compose` at up-time.

# ------------------------------------------------------------- domains/TLS
# Root domain -- Caddy serves <DOMAIN>, app.<DOMAIN>, admin.<DOMAIN>,
# api.<DOMAIN>, www.<DOMAIN>. DNS A records must exist for all five.
DOMAIN=kibasfpltreats.com
# Let's Encrypt registration email (expiry notices).
ACME_EMAIL=admin@kibasfpltreats.com

# ------------------------------------------------------------------ admin
# Shared secret for the Admin API (required; admin endpoints fail closed
# without it). The admin panel BFF uses the same value to call the backend.
ADMIN_API_TOKEN=change-me-to-a-long-random-string

# --------------------------------------------------------------- postgres
POSTGRES_DB=fpl
POSTGRES_USER=fpl
POSTGRES_PASSWORD=change-me-too

# ------------------------------------------------------------------ clerk
# Dashboard auth (Phase 13). From https://dashboard.clerk.com -> API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_<your-publishable-key>
CLERK_SECRET_KEY=sk_live_<your-secret-key>
# Post-auth landing route for the dashboard app. Inlined at build time.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
# Backend JWT verification: API Keys -> Advanced -> JWKS URL.
CLERK_JWKS_URL=https://<your-clerk-frontend-api>/.well-known/jwks.json
# Required exact value of the Clerk session token's `aud` claim. Configure
# this in Clerk's session-token settings; it is often your frontend origin.
CLERK_AUDIENCE=https://app.<your-domain>
# Required exact value of the Clerk session token's `iss` claim, normally your
# Clerk Frontend API / instance URL (for example, https://<instance>.clerk.accounts.dev).
CLERK_ISSUER=https://<your-clerk-frontend-api>

# ---------------------------------------------------------------- admin app
# At least one is required by apps/admin. ADMIN_EMAIL requires a Clerk session
# token custom claim named `email` or `email_address`; ADMIN_ROLE uses Clerk's
# active organization role (for example, org:admin).
ADMIN_EMAIL=admin@example.com
ADMIN_ROLE=
