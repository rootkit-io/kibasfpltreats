# Copy to .env.local and fill in before `npm run dev` or Docker build.

# Clerk publishable key (safe to expose to the browser -- it's public).
# Get it from: https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_<your-publishable-key>

# Clerk secret key (server-side only -- NEVER expose to the browser).
# Get it from: https://dashboard.clerk.com -> API Keys
CLERK_SECRET_KEY=sk_test_<your-secret-key>

# Where Clerk sends users after sign-in / sign-up when no redirect_url was
# supplied on the request. /dashboard is an alias that redirects to / (the
# grid), so both entry points land in the same place.
# NOTE these are NEXT_PUBLIC_*, so they are inlined at BUILD time -- they must
# be passed as docker build args, not only as runtime env (see the Dockerfile).
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Backend URL (server-side only). In Docker: http://backend:8000
# In local dev: http://127.0.0.1:8000
FPL_BACKEND_URL=http://127.0.0.1:8000
