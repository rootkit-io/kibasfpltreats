# Clerk browser/server keys. Never prefix secrets with NEXT_PUBLIC_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key

# At least one authorization criterion is required. Email authorization needs
# a Clerk session-token custom claim named `email` or `email_address`.
ADMIN_EMAIL=admin@example.com
# Optional Clerk active-organization role, for example: org:admin
ADMIN_ROLE=

# Existing BFF-to-backend configuration. This stays server-only.
FPL_BACKEND_URL=http://127.0.0.1:8000
ADMIN_API_TOKEN=replace-with-a-long-random-secret
