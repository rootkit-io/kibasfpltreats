# Copy to .env and fill in before starting the backend.

# Admin API token (required -- admin endpoints fail closed without it).
ADMIN_API_TOKEN=change-me

# PostgreSQL connection string.
DATABASE_URL=postgresql://fpl:fpl@localhost:5432/fpl

# Clerk JWKS URL for JWT verification on the public router (Phase 13).
# Get it from: https://dashboard.clerk.com -> API Keys -> Advanced
# Format: https://<your-clerk-frontend-api>/.well-known/jwks.json
CLERK_JWKS_URL=https://<your-clerk-frontend-api>/.well-known/jwks.json

# Optional: Clerk audience claim to validate (recommended for production).
# Set to your Clerk Frontend API URL, e.g. https://your-app.clerk.accounts.dev
# When unset, audience validation is skipped (acceptable for development).
CLERK_AUDIENCE=
